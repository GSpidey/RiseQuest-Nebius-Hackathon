require 'base64'
require 'json'
require 'tmpdir'
require 'securerandom'

default_platform(:ios)

platform :ios do
  desc 'Signed RiseQuest upload to TestFlight; does not submit or publish to App Store'
  lane :testflight do
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 IOS_DISTRIBUTION_P12_BASE64 IOS_DISTRIBUTION_P12_PASSWORD IOS_APPSTORE_PROFILE_BASE64]
    missing = required.select { |key| ENV[key].to_s.empty? }
    UI.user_error!("Missing signing configuration: #{missing.join(', ')}") unless missing.empty?
    root = File.expand_path('../..', __dir__)
    release = JSON.parse(File.read(File.join(root, 'tools/ios-release-request.json')))
    version = release.fetch('version')
    next_build = release.fetch('buildNumber')
    UI.user_error!('Invalid explicit TestFlight release request') unless version.match?(/\A\d+\.\d+\.\d+\z/) && next_build.is_a?(Integer) && next_build > 0 && release['delivery'] == 'testflight' && release['productionRelease'] == false
    bundle_id = 'com.goldenepics.risequest'
    keychain_name = "risequest-ci-#{SecureRandom.hex(6)}"
    keychain_password = SecureRandom.hex(32)
    api_key = app_store_connect_api_key(key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8_BASE64'), is_key_content_base64: true)
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
    UI.user_error!('RiseQuest App Store record is missing') unless Spaceship::ConnectAPI::App.find(bundle_id)
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id, version: version, initial_build_number: 0)
    UI.user_error!("Build #{version} (#{next_build}) is already used; choose another explicit build number") if latest.to_i >= next_build
    Dir.mktmpdir('risequest-signing') do |dir|
      p12 = File.join(dir, 'distribution.p12')
      profile = File.join(dir, 'appstore.mobileprovision')
      File.binwrite(p12, Base64.strict_decode64(ENV.fetch('IOS_DISTRIBUTION_P12_BASE64')))
      File.binwrite(profile, Base64.strict_decode64(ENV.fetch('IOS_APPSTORE_PROFILE_BASE64')))
      File.chmod(0600, p12)
      File.chmod(0600, profile)
      begin
        create_keychain(name: keychain_name, password: keychain_password, default_keychain: false, unlock: true, timeout: 3600)
        import_certificate(certificate_path: p12, certificate_password: ENV.fetch('IOS_DISTRIBUTION_P12_PASSWORD'), keychain_name: keychain_name, keychain_password: keychain_password)
        installed = install_provisioning_profile(path: profile)
        info = FastlaneCore::ProvisioningProfile.parse(profile)
        UI.user_error!('Wrong signing team or bundle ID') unless info['TeamIdentifier'].include?('928X72628Q') && info.dig('Entitlements', 'application-identifier') == "928X72628Q.#{bundle_id}"
        update_code_signing_settings(use_automatic_signing: false, path: File.join(root, 'ios/RiseQuest.xcodeproj'), team_id: '928X72628Q',
          code_sign_identity: 'Apple Distribution', bundle_identifier: bundle_id, profile_name: info.fetch('Name'), targets: ['RiseQuest'])
        increment_version_number(version_number: version, xcodeproj: File.join(root, 'ios/RiseQuest.xcodeproj'))
        increment_build_number(build_number: next_build.to_s, xcodeproj: File.join(root, 'ios/RiseQuest.xcodeproj'))
        FileUtils.mkdir_p(File.join(root, 'artifacts'))
        File.write(File.join(root, 'artifacts/apple-build-number.txt'), next_build.to_s)

        build_app(workspace: File.join(root, 'ios/RiseQuest.xcworkspace'), scheme: 'RiseQuest', configuration: 'Release',
          export_method: 'app-store', output_directory: File.join(root, 'artifacts'), output_name: 'RiseQuest.ipa',
          export_options: { provisioningProfiles: { bundle_id => info.fetch('Name') }, signingStyle: 'manual', teamID: '928X72628Q' })
        sh('python3', File.join(root, 'tools/verify-mobile-artwork.py'), File.join(root, 'artifacts/RiseQuest.ipa'))
        upload_to_testflight(api_key: api_key, ipa: File.join(root, 'artifacts/RiseQuest.ipa'), skip_waiting_for_build_processing: true,
          distribute_external: false, notify_external_testers: false)
      ensure
        File.delete(installed) if installed && File.file?(installed)
        delete_keychain(name: keychain_name) if File.exist?(File.expand_path("~/Library/Keychains/#{keychain_name}-db"))
      end
    end
  end
end

